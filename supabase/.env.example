# Variables de entorno del backend Supabase de referencia (Slice C3).
# Copiar este archivo a .env (nunca versionar .env) y completar los valores.

# Configuracion de Supabase (se obtienen del panel de Supabase).
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon-key-publica>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-secreta>

# Clave simetrica compartida para envolver/derivar claves de contenido.
# Debe coincidir con SERVER_BUNDLE_KEY del lado del cliente.
SERVER_BUNDLE_KEY=<base64-32-bytes>

# Clave privada del servidor para firmar recibos (ed25519, 32 bytes base64).
SERVER_RECEIPT_PRIVATE_KEY=<base64-32-bytes>

# Clave publica del servidor para que el cliente verifique recibos.
SERVER_RECEIPT_PUBLIC_KEY=<base64-32-bytes>

# Secreto para validar webhooks del proveedor KYC (opcional).
KYC_WEBHOOK_SECRET=<secreto-del-proveedor>
